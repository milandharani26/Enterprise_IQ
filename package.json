{
  "name": "enterpriseiq",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build:frontend": "npm run build --prefix enterpriseiq-frontend",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "npm run start:prod --prefix backend"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.8.4"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "npx prettier --write"
    ],
    "enterpriseiq-frontend/**/*.{ts,tsx}": [
      "npx prettier --write"
    ]
  }
}
